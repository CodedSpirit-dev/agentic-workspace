{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workspace.local/schemas/agent-order-result-1.0.json",
  "title": "Agent order execution result",
  "type": "object",
  "required": ["schema_version", "order_id", "status", "execution", "changes", "validation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "order_id": {"type": "string"},
    "status": {"enum": ["executed", "verified", "closed", "failed"]},
    "execution": {
      "type": "object",
      "required": ["mode", "executed_by"],
      "properties": {
        "mode": {"enum": ["handoff", "direct", "automated", "manual", "orchestrated"]},
        "executed_by": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "changes": {"type": "array", "items": {"type": "object"}},
    "skipped_changes": {"type": "array", "items": {"type": "object"}},
    "failed_changes": {"type": "array", "items": {"type": "object"}},
    "validation": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_required"]},
        "checks": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "rollback_artifacts": {"type": "array", "items": {"type": "string"}},
    "follow_ups": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
