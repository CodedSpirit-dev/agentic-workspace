{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workspace.local/schemas/agent-order-context-1.0.json",
  "title": "Portable agent order context",
  "type": "object",
  "required": ["schema_version", "order_id", "title", "domain", "status", "objective", "scope", "out_of_scope", "authorization", "constraints", "validation", "rollback"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "order_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "status": {"type": "string"},
    "priority": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "execution_mode": {"enum": ["handoff", "direct", "automated", "manual", "orchestrated"]},
    "documentation_mode": {"enum": ["planned", "retrospective"]},
    "objective": {"type": "string", "minLength": 1},
    "background": {"type": "string"},
    "authorization": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "out_of_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "blast_radius": {"type": "array", "items": {"type": "string"}},
    "execution": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "object"},
    "validation": {"type": "object", "required": ["required", "checks"], "properties": {"required": {"type": "boolean"}, "checks": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "object", "required": ["required", "procedure"], "properties": {"required": {"type": "boolean"}, "procedure": {"type": "array", "items": {"type": "string"}}, "justification": {"type": "string"}}, "additionalProperties": false},
    "expected_result": {"type": "string"},
    "follow_ups": {"type": "array", "items": {"type": "string"}},
    "decision_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "convention_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "finding_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "deliverable_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verification_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_credentials": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "uniqueItems": true},
    "claim": {"type": ["object", "null"]},
    "completion_marker": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
