{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workspace.local/schemas/artifact-2.1.json",
  "title": "Registered artifact",
  "type": "object",
  "required": ["id", "type", "title", "status", "path", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"},
    "type": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "path": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verification_method": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
