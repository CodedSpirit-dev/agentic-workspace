#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"

if grep -qiE '^[[:space:]]*Co-Authored-By[[:space:]]*:' "$message_file"; then
  echo "BLOCKED: Co-Authored-By trailers are not allowed in this repository." >&2
  exit 1
fi

if grep -qiE 'Generated by (Claude|Codex|ChatGPT|GPT|AI)|((Claude|Codex|ChatGPT|OpenAI|Anthropic) (agent|model))' "$message_file"; then
  echo "BLOCKED: AI, model, or agent attribution is not allowed in commit messages." >&2
  exit 1
fi

exit 0
